# ---------------------------------------------------------------
# ENCORE configuration. Copy to .env.local and fill in.
# Anything left empty switches that feature into a clearly labeled
# offline state. ENCORE never substitutes made-up data.
# ---------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local...).
# Required for community voting and the vote-ranked leaderboard.
DATABASE_URL=

# Set to "require" for hosted Postgres that needs TLS (most do).
DATABASE_SSL=require

# Solana RPC used server-side (balances, simulation, confirmations, voter checks).
# The public endpoint works for testing but is heavily rate limited.
# Recommended: a Helius / Triton / QuickNode URL (the key stays on the server).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter Swap API v2 key (https://developers.jup.ag/portal). Required for trading.
JUPITER_API_KEY=

# Optional: Jupiter referral account + fee (50-255 bps) if you want ENCORE to
# charge a platform fee. Leave empty for no ENCORE fee. Any fee set here is
# shown to the user before every trade.
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=

# Optional: Birdeye key. When set, charts use Birdeye token-level OHLCV;
# otherwise GeckoTerminal pool OHLCV (no key, ~30 req/min).
BIRDEYE_API_KEY=

# Voting rules (see /rules).
# Minimum SOL a wallet must hold to vote (anti-sybil). 0 disables the check.
MIN_VOTER_SOL=0.01
# Secret salt used to hash voter IPs for rate limiting. Use a long random string.
VOTE_IP_SALT=change-me-to-a-long-random-string
